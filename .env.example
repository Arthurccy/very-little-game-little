# --- Base de données (docker-compose.yml) ---
POSTGRES_USER=fps
POSTGRES_PASSWORD=fps_dev_password
POSTGRES_DB=fps_edu
DATABASE_URL=postgresql://fps:fps_dev_password@localhost:54329/fps_edu?schema=public
# Base des tests d'intégration (par défaut : DATABASE_URL suffixée de « _test »)
# DATABASE_URL_TEST=postgresql://fps:fps_dev_password@localhost:54329/fps_edu_test?schema=public

# --- API (étape 2) ---
API_PORT=43124
CLIENT_ORIGIN=http://localhost:43123
# Secret du JWT d'accès : au moins 32 caractères aléatoires (ex. `openssl rand -base64 48`).
# Le refresh token est un jeton opaque stocké haché en base : il n'a pas besoin de secret.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Cookie refresh en Secure (true d'office si NODE_ENV=production)
# COOKIE_SECURE=false

# --- Client ---
VITE_API_URL=http://localhost:43124

# --- Seed : compte administrateur ---
ADMIN_EMAIL=admin@example.com
ADMIN_PSEUDO=admin
ADMIN_PASSWORD=change-me-admin-password
