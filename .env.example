# --- Base de données (docker-compose.yml) ---
POSTGRES_USER=fps
POSTGRES_PASSWORD=fps_dev_password
POSTGRES_DB=fps_edu
DATABASE_URL=postgresql://fps:fps_dev_password@localhost:54329/fps_edu?schema=public

# --- API (étape 2) ---
API_PORT=43124
CLIENT_ORIGIN=http://localhost:43123
# Secrets JWT : au moins 32 caractères aléatoires (ex. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Client ---
VITE_API_URL=http://localhost:43124

# --- Seed : compte administrateur ---
ADMIN_EMAIL=admin@example.com
ADMIN_PSEUDO=admin
ADMIN_PASSWORD=change-me-admin-password
